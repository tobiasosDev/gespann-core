{
  "name": "gespann",
  "version": "0.3.0",
  "description": "Acceptance testing for coding agents: an independent agent tests each PR in a production-near environment and reports a verdict back to Claude Code and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gespann": "dist/bin.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiasosDev/gespann-core.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.21",
    "yaml": "^2.9.1"
  }
}
