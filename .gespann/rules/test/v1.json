{
  "id": "test",
  "version": 1,
  "title": "Tests pass before a change is reported as done",
  "why": "Failing tests found in CI cost a round trip.",
  "paths": [
    "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"
  ],
  "check": {
    "command": "npm run test",
    "match": "\\b(?:bun|npm|pnpm|yarn|npx|bunx)\\b[^\\n;&|]*\\btest\\b(?![-:])"
  },
  "level": "observe",
  "ci": "report"
}
